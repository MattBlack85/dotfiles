;; ----------- Workspaces -------------
(defpoll WS :interval "500ms" :initial "[]" "~/.config/eww/scripts/workspaces_json.sh")

(defpoll HOST :interval "3600s" :initial "" "hostname | tr '[:lower:]' '[:upper:]'")

;; ----------- System Stats -----------
(defpoll CPU :interval "2s" :initial "0" "~/.config/eww/scripts/cpu.sh")
(defpoll GPU :interval "2s" :initial "0" "~/.config/eww/scripts/gpu.sh")
(defpoll MEM :interval "3s" :initial "{\"pct\":0,\"used\":\"-\",\"free\":\"-\",\"total\":\"-\"}" "~/.config/eww/scripts/mem.sh")

;; ----------- Volume ------------------
(defpoll VOLUME :interval "1s" "~/.config/eww/scripts/get_volume.sh")

;; ----------- Clock & Weather --------
(defpoll TIME :interval "1s" "date '+%H:%M:%S'")
(defpoll DATE :interval "60s" "date '+%a %d %b' | tr '[:lower:]' '[:upper:]'")
(defpoll WEATHER :interval "600s" "~/.config/eww/scripts/weather.sh")

;; ----------- Segments ---------------

(defwidget workspaces []
  (box :class "seg seg-ws" :orientation "h" :space-evenly false :spacing 4
    (label :class "seg-tag" :truncate false :text "${HOST}//")
    (for w in WS
      (button :class {w.active ? "ws ws-active" : "ws"}
              :onclick "hyprctl dispatch 'ws_here(${w.id})'"
        {w.name}))))

(defwidget stats []
  (box :class "seg seg-stats" :orientation "h" :space-evenly false :spacing 28
    (box :class "stat cpu" :orientation "h" :space-evenly false :spacing 10
      (label :class "icon" :text "")
      (label :text "${CPU}%")
      (progress :class "meter" :orientation "h" :value CPU :valign "center"))
    (box :class "stat gpu" :orientation "h" :space-evenly false :spacing 10
      (label :class "icon" :text "󰢮")
      (label :text "${GPU}%")
      (progress :class "meter" :orientation "h" :value GPU :valign "center"))
    (box :class "stat mem" :orientation "h" :space-evenly false :spacing 10
      (label :class "icon" :text "󰍛")
      (label :text "${MEM.used}/${MEM.free}")
      (progress :class "meter" :orientation "h" :value {MEM.pct} :valign "center"))))

(defwidget status [monitor]
  (box :class "seg seg-right" :orientation "h" :space-evenly false :spacing 18
    (box :class {VOLUME == "MUTED" ? "stat vol muted" : "stat vol"} :orientation "h" :space-evenly false :spacing 8
      (label :class "icon"
             :text {VOLUME == "MUTED" ? "󰝟" : VOLUME >= 60 ? "󰕾" : VOLUME >= 25 ? "󰖀" : "󰕿"})
      (label :text {VOLUME == "MUTED" ? "MUTED" : "${VOLUME}%"}))
    (eventbox :cursor "pointer"
              :tooltip "Click to set the weather location"
              :onclick "eww open weather-input --arg monitor=${monitor}"
      (label :class "stat weather" :text " ${WEATHER}"))
    (label :class "stat date" :text " ${DATE}")
    (label :class "stat time" :text "${TIME}")))

;; ----------- Bar Window -------------

(defwindow bar [monitor]
  :monitor monitor
  :geometry (geometry :x "0" :y "0" :width "100%" :height "40px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  (box :class "bar" :orientation "h" :space-evenly false
    (box :halign "start" :hexpand false (workspaces))
    (box :halign "center" :hexpand true (stats))
    (box :halign "end" :hexpand false (status :monitor monitor))))

;; ----------- Weather location input -
;; Opened by clicking the weather item. Enter saves, empty value = auto-detect.

(defwindow weather-input [monitor]
  :monitor monitor
  :geometry (geometry :x "12px" :y "46px" :width "320px" :anchor "top right")
  :stacking "overlay"
  :focusable true
  :exclusive false
  (box :class "seg seg-input" :orientation "h" :space-evenly false :spacing 10
    (label :class "seg-tag" :text "LOCATION")
    (input :class "loc-input"
           :onaccept "~/.config/eww/scripts/set_location.sh '{}'")))
